<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'XIVChat Desktop'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>XIVChat_Desktop.DesktopSmokeProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'XIVChat Desktop'">
    <Compile Include="$(MSBuildThisFileDirectory)DesktopSmoke.cs" />
  </ItemGroup>
</Project>
