<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'XIVChat Desktop'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>XIVChat_Desktop.DesktopSetupSmokeProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'XIVChat Desktop'">
    <Compile Include="$(MSBuildThisFileDirectory)DesktopSetupSmoke.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DesktopRelaySmoke.cs" />
  </ItemGroup>
</Project>
