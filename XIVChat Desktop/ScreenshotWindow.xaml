<Window x:Class="XIVChat_Desktop.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="QualityPicker" MinWidth="200" SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem x:Name="StandardOption"/><ComboBoxItem x:Name="DetailedOption"/>
            </ComboBox>
            <Button x:Name="CaptureButton" Grid.Column="1" Click="Capture_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Grid.Column="4" Click="Save_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock x:Name="StateText" TextWrapping="Wrap"/>
            <ProgressBar x:Name="TransferProgress" Height="3" Maximum="100"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#FF131820" CornerRadius="8">
            <Grid>
                <ScrollViewer x:Name="Viewport" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="4"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Viewport_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="None"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" Margin="28">
                    <FontIcon Glyph="&#xE722;" FontSize="42" Foreground="#FFAAB6C4"/>
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FFE4EAF2"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="SourceText" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailsText" Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="FitButton" Click="Fit_Click"/>
                <Button x:Name="ActualButton" Content="100%" Click="Actual_Click"/>
                <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click"/>
                <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
