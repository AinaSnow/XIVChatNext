<Window x:Class="XIVChat_Desktop.TrustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:XIVChat_Desktop"
        mc:Ignorable="d"
       >
    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0"
                   Grid.Row="0"
                   TextWrapping="Wrap" MaxWidth="560"
                   local:Localize.Text="TrustDialog.Description" />

        <Grid Grid.Column="0"
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       local:Localize.Text="TrustDialog.Server" />
            <TextBlock x:Name="ServerPublicKey"
                       Grid.Row="1"
                       Grid.Column="0" />
            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Height="24"
                  x:Name="ServerPublicKeyColours">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" />
                <Rectangle Grid.Column="1" />
                <Rectangle Grid.Column="2" />
                <Rectangle Grid.Column="3" />
                <Rectangle Grid.Column="4" />
                <Rectangle Grid.Column="5" />
                <Rectangle Grid.Column="6" />
                <Rectangle Grid.Column="7" />
                <Rectangle Grid.Column="8" />
                <Rectangle Grid.Column="9" />
                <Rectangle Grid.Column="10" />
            </Grid>
        </Grid>

        <Grid Grid.Column="0"
              Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       local:Localize.Text="TrustDialog.Client" />
            <TextBlock x:Name="ClientPublicKey"
                       Grid.Row="1"
                       Grid.Column="0" />
            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Height="24"
                  x:Name="ClientPublicKeyColours">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" />
                <Rectangle Grid.Column="1" />
                <Rectangle Grid.Column="2" />
                <Rectangle Grid.Column="3" />
                <Rectangle Grid.Column="4" />
                <Rectangle Grid.Column="5" />
                <Rectangle Grid.Column="6" />
                <Rectangle Grid.Column="7" />
                <Rectangle Grid.Column="8" />
                <Rectangle Grid.Column="9" />
                <Rectangle Grid.Column="10" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3"
                   Grid.Column="0"
                   Orientation="Vertical">
            <TextBlock local:Localize.Text="TrustDialog.KeyName" />
            <TextBox x:Name="KeyName" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   local:Localize.Text="TrustDialog.Question" />

        <StackPanel Grid.Row="5"
                   Grid.Column="0"
                   Orientation="Horizontal">
            <Button Click="Yes_Click" local:Localize.Content="Dialog.Yes" />
            <Button Click="No_Click" local:Localize.Content="Dialog.No" />
        </StackPanel>
    </Grid>
</Window>
