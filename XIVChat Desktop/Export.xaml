<Window x:Class="XIVChat_Desktop.Export"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="6"><TextBlock x:Name="Scope" TextWrapping="Wrap" FontSize="17"/><TextBlock x:Name="Explanation" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/></StackPanel>
        <TextBox x:Name="Keyword" Grid.Row="1"/>
        <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="6"><CalendarDatePicker x:Name="FromDate"/><TimePicker x:Name="FromTime" ClockIdentifier="24HourClock"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="6"><CalendarDatePicker x:Name="UntilDate"/><TimePicker x:Name="UntilTime" ClockIdentifier="24HourClock"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12"><CheckBox x:Name="Timestamps" IsChecked="True"/><Button x:Name="PreviewButton" Click="Preview_Click"/><Button x:Name="ClearDates" Click="ClearDates_Click"/></StackPanel>
        <ListView x:Name="PreviewList" Grid.Row="4" SelectionMode="None" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"/></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="1" Click="Cancel_Click"/><Button x:Name="SaveButton" Grid.Column="2" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
